  "templates": [
    {
      "id": "t1",
      "name": "Cold intro — hiring manager",
      "category": "cold-intro",
      "subject": "{{role}} at {{company}} — quick note",
      "body": "Hi {{firstName}},\n\nI saw {{company}} is hiring for {{role}} and wanted to reach out directly rather than disappear into the applicant pool.\n\n{{hook}}\n\nTwo things that might be relevant:\n- [Proof point 1 — a result with a number in it]\n- [Proof point 2 — most relevant experience for this role]\n\nI'm a UAE National, so my hire also counts toward {{company}}'s Emiratisation targets — but I'd rather earn the role on merit; happy to walk you through my work in 15 minutes.\n\nBest,\n{{myName}}\n{{headline}}\n{{linkedin}} | {{phone}}"
    },
    {
      "id": "t2",
      "name": "Emiratisation angle — HR / TA lead",
      "category": "emiratisation",
      "subject": "Emirati candidate — {{role}} ({{company}})",
      "body": "Dear {{firstName}},\n\nI'm an Emirati professional ({{headline}}) exploring {{role}} opportunities at {{company}}.\n\nBeyond the fit for the role itself, I understand hiring UAE Nationals is a priority — my hire counts toward your MoHRE Emiratisation targets, and Nafis support (salary top-up and employer pension contribution) applies.\n\n{{hook}}\n\nWould you be open to a short call this week, or could you point me to the right hiring manager?\n\nWith thanks,\n{{myName}}\n{{linkedin}} | {{phone}}"
    },
    {
      "id": "t3",
      "name": "Follow-up 1 (day 3)",
      "category": "followup",
      "subject": "Re: {{role}} at {{company}}",
      "body": "Hi {{firstName}},\n\nFollowing up on my note from a few days ago — I know inboxes are brutal.\n\nOne line on why I'm worth 15 minutes: {{hook}}\n\nIf someone else owns this hire, a quick redirect would be hugely appreciated.\n\nBest,\n{{myName}}"
    },
    {
      "id": "t4",
      "name": "Follow-up 2 — breakup (day 8)",
      "category": "followup",
      "subject": "Re: {{role}} at {{company}} — closing the loop",
      "body": "Hi {{firstName}},\n\nLast note from me — I'll assume the timing isn't right and won't clutter your inbox further.\n\nIf a {{role}}-shaped need comes up later, my details are below and I'd genuinely love to talk. Either way, thanks for reading.\n\nBest,\n{{myName}}\n{{linkedin}} | {{phone}}"
    },
    {
      "id": "t5",
      "name": "Post-application nudge",
      "category": "application",
      "subject": "Applied for {{role}} — putting a face to the application",
      "body": "Hi {{firstName}},\n\nI just applied for the {{role}} opening at {{company}} (application under {{myName}}) and wanted to introduce myself directly.\n\n{{hook}}\n\nI'm also a UAE National, which I understand is relevant for {{company}}'s Emiratisation goals. If it's useful, I'm happy to share a short summary of exactly how I'd approach the first 90 days in this role.\n\nBest,\n{{myName}}\n{{headline}}\n{{linkedin}} | {{phone}}"
    },
    {
      "id": "t6",
      "name": "Referral ask (2nd-degree connection)",
      "category": "referral",
      "subject": "Quick favour — {{role}} at {{company}}",
      "body": "Hi {{firstName}},\n\nHope you're well! I'm applying for {{role}} at {{company}} and saw you're connected there.\n\n{{hook}}\n\nWould you be comfortable referring me, or introducing me to the hiring manager? Happy to send a short blurb + CV to make it zero-effort. And of course, tell me if it's awkward — no pressure at all.\n\nThanks either way,\n{{myName}}"
    }
  ]
}